# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Create a free project at https://www.sanity.io/manage and paste the IDs here.
# While these are empty, the site renders from the local seed content and the
# /studio route stays offline — nothing breaks.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---------------------------------------------------------------------------
# Site URL (SEO)
# ---------------------------------------------------------------------------
# Production domain — used for canonical URLs, sitemap, robots and Open Graph.
# Falls back to https://manuelaugusto.pt when unset.
NEXT_PUBLIC_SITE_URL=https://manuelaugusto.pt

# ---------------------------------------------------------------------------
# Email (contact form → Resend)
# ---------------------------------------------------------------------------
# Optional. While unset, the contact form still works and accepts messages
# (logged server-side). Set all three to deliver messages by email.
# Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=geral@manuelaugusto.pt
CONTACT_FROM_EMAIL=website@manuelaugusto.pt
